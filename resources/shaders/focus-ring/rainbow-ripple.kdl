// Copy this directory together with its .frag files, then include this preset.
// Editing rainbow-ripple.frag automatically reloads the effect.
layout {
    focus-ring {
        on
        width 6
        shader {
            path "rainbow-ripple.frag"
            padding 14
        }
    }
}
// Optionally set shader-animation-max-fps 60 at the top level of config.kdl.
